#!/usr/bin/env bash
# Claude Code PreToolUse hook for the loop agent, installed by loop/setup, and
# for the driver, installed by loop/drive.
# Claude Code's deny rules cover its own file tools but not the shell, so this
# blocks any tool call that names a denied place, the TRACTOR or CodeNet
# corpus, a scratch directory of the evaluator or Claude Code's own files, and
# for the loop agent any MCP tool or
# skill from outside loop/skills.
# Usage: guard [--driver] OWN_DIR MARKER..., where OWN_DIR is the agent's
# transcript directory, whose saved tool output it may read back. The driver
# works in a T3 Code thread with the owner's skills, so --driver lets MCP
# tools and skills through and lets it read the skills' files.
# Exit code 2 blocks the call; on unreadable input it blocks too.

block() {
  echo "Blocked: $1. The agent may not reach the private programs or the corpus that holds them; see loop/program.md or loop/driver.md." >&2
  exit 2
}

# Whether text $1 names $2 as a whole path or name: not as part of a longer
# one, such as a sibling directory that starts the same.
names() {
  local escaped pattern
  escaped=$(sed 's/[][\.*^$(){}?+|]/\\&/g' <<<"$2")
  pattern="(^|[^A-Za-z0-9_.-])$escaped([^A-Za-z0-9_.-]|\$)"
  [[ $1 =~ $pattern ]]
}

driver=false
if [[ ${1-} == --driver ]]; then
  driver=true
  shift
fi
own=$1
shift
input=$(cat)
tool=$(jq -r '.tool_name // ""' <<<"$input") || block "the hook could not read the tool call"
# The input's strings, decoded, so that an escape such as \n cannot hide where
# a path starts.
text=$(jq -r '[.tool_input | .. | strings] | join("\n")' <<<"$input") || block "the hook could not read the tool call"
[[ -n $tool ]] || block "the hook got no tool name"

# MCP servers, such as T3 Code's, give tools that reach past this checkout:
# other threads, a browser, agents in other directories.
if ! $driver && [[ $tool == mcp__* ]]; then
  block "the loop agent uses no MCP tools"
fi
# Only the loop's own skills, from this checkout, which the agent cannot edit.
if ! $driver && [[ $tool == Skill ]]; then
  skill=$(jq -r '.tool_input.skill // ""' <<<"$input")
  if [[ ! $skill =~ ^[A-Za-z0-9_-]+$ || ! -f $(dirname "$0")/skills/$skill/SKILL.md ]]; then
    block "the loop agent uses only the skills in loop/skills"
  fi
fi

# A name runs on into a dot, so CodeNet's archive and repository are named in full.
for marker in "$@" DARPA-TRACTOR-Program PUBLIC-Test-Corpus Project_CodeNet \
  Project_CodeNet.tar.gz Project_CodeNet.git; do
  if names "$text" "$marker"; then
    block "the call names $marker"
  fi
done
# While the gate judges a commit, the evaluator's scratch directories hold
# copies of private programs and their translations. Their names end in
# numbers, so a start is what gives them away.
if [[ $text =~ (^|[^A-Za-z0-9_.-])c2r-(eval|gate)- ]]; then
  block "the call names a scratch directory of the evaluator"
fi
# The driver and the workers it starts run outside a sandbox, so plain cargo
# would build or run the transpiler, which is agent code, on the machine
# that holds the private programs; loop/cargo runs it in a sandbox. A
# workspace build includes the transpiler too, and so does a build from its
# directory.
if $driver && [[ $tool == Bash ]]; then
  cargo='^[[:space:]]*([A-Za-z_][A-Za-z0-9_]*=[^[:space:]]*[[:space:]]+)*cargo[[:space:]]+(\+[^[:space:]]+[[:space:]]+)?(build|b|check|c|clippy|test|t|run|r|bench|rustc|doc|install)([[:space:]]|$)'
  target='(-p|--package)([[:space:]]+|=)transpiler([^A-Za-z0-9_-]|$)|--workspace([^A-Za-z0-9_-]|$)|--all([^A-Za-z0-9_-]|$)|--manifest-path([[:space:]]+|=)[^[:space:]]*transpiler'
  in_crate=false
  [[ $text =~ (^|[^A-Za-z0-9_.-])cd[[:space:]]+[^[:space:]\;\&\|]*crates/transpiler ]] && in_crate=true
  while IFS= read -r part; do
    if [[ $part =~ $cargo ]] && { [[ $part =~ $target ]] || $in_crate; }; then
      block "the call runs the transpiler's build outside the sandbox; use loop/cargo"
    fi
  done < <(sed -E 's/(&&|\|\||[;|&(])/\n/g' <<<"$text")
fi
# Settings, transcripts, memory and the owner's skills are off limits. The
# agent may read back the tool output that Claude Code saved for it, but a
# path with .. could climb out of that directory.
rest=$text
if [[ $tool == Read && $rest != *..* ]]; then
  rest=${rest//"$own"/}
  if $driver; then
    rest=${rest//"$HOME/.claude/skills/"/}
  fi
fi
if names "$rest" .claude; then
  block "the call touches Claude Code's files"
fi
exit 0
