#!/usr/bin/env bash
# The GitHub step of a round, run by loop/round --github after the gate: takes
# main's kept commits to GitHub as a stack of pull requests, one per batch, and
# brings back what CI and CodeRabbit said there. It posts the loop agent's
# replies to review comments, merges the stack from the bottom by fast-forward
# as far as CodeRabbit has reviewed it with every thread resolved and up to a
# head whose checks pass, publishes a new batch at most every two hours, and
# writes the open comments and failed checks into the fresh loop checkout as
# REVIEWS.md. The loop agent itself never reaches GitHub. See
# docs/architecture.md.
set -euo pipefail

if (($# != 5)); then
  echo "usage: loop/github STATE_DIR LOOP_DIR CANDIDATE keep|reject MODEL" >&2
  exit 2
fi
state=$1
loop=$2
candidate=$3
decision=$4
model=$5
cd "$(dirname "$0")/.."

touch "$state/models"
for file in offered outbox; do
  [[ -f $state/$file.json ]] || echo '[]' >"$state/$file.json"
done
body=$(mktemp)
trap 'rm -f "$body"' EXIT
# Rewrites the outbox of replies with a jq filter, by rename, so that a stopped
# run cannot leave it cut short.
outbox() {
  jq -c "$@" "$state/outbox.json" >"$state/outbox.json.new"
  mv "$state/outbox.json.new" "$state/outbox.json"
}

# Each batch is a branch loop/TIME with a pull request into the batch below it,
# or into main for the bottom one.
prefix=loop/
interval=$((2 * 60 * 60))
bot=coderabbitai
# How many times CodeRabbit may answer the agent's replies in a thread before
# the owner decides, so that the two cannot argue forever.
disputes=2
slug=$(gh repo view --json nameWithOwner --jq .nameWithOwner)
viewer=$(gh api user --jq .login)
note="> [!NOTE]
> 🤖 **$model replied on behalf of $viewer**"

# The open pull requests from this repository's loop branches, with the checks
# on their heads and their review threads. It fails when more are open than it
# reads, since a missing batch would look like an empty stack.
pull_requests() {
  local prs
  prs=$(gh api graphql -f owner="${slug%/*}" -f name="${slug#*/}" -f query='
    query($owner: String!, $name: String!) {
      repository(owner: $owner, name: $name) {
        pullRequests(states: OPEN, first: 50) {
          totalCount
          nodes {
            number url baseRefName headRefName headRefOid isCrossRepository
            commits(last: 1) { nodes { commit { statusCheckRollup { contexts(first: 100) {
              totalCount
              nodes {
                __typename
                ... on CheckRun { name status conclusion detailsUrl }
                ... on StatusContext { context state }
              }
            } } } } }
            reviewThreads(first: 100) {
              totalCount
              nodes { id isResolved comments(first: 30) { totalCount nodes {
                databaseId url path line author { login } body
              } } }
            }
          }
        }
      }
    }' --jq ".data.repository.pullRequests | if .totalCount > (.nodes | length) then null
      else [.nodes[] | select((.isCrossRepository | not) and (.headRefName | startswith(\"$prefix\")))] end") ||
    return
  if [[ $prs == null ]]; then
    echo "github: more than 50 pull requests are open; the step reads only 50" >&2
    return 1
  fi
  echo "$prs"
}
# The stack, from the pull request into main upwards. A loop pull request off
# the stack is the owner's.
stack_of() {
  jq -c 'def chain($base): . as $prs | ($prs | map(select(.baseRefName == $base)) | first) as $pr
    | if $pr == null then [] else [$pr] + ($prs | chain($pr.headRefName)) end;
    chain("main")' <<<"$1"
}
prs=$(pull_requests)
stack=$(stack_of "$prs")
jq -r --argjson stack "$stack" '.[] | select(.number as $n | $stack | map(.number) | index($n) | not)
  | "github: #\(.number) is not stacked on main; the owner decides: \(.url)"' <<<"$prs"

git fetch -q --no-tags --prune origin
# The step never rewrites main, so commits that only GitHub's main has must be
# pulled by hand, between rounds. Commits on a loop branch that main lacks did
# not pass the gate, and are the owner's to keep or drop. Each batch must also
# hold the one below it, or merging it would drop that one.
synced=true
if ! git merge-base --is-ancestor origin/main main; then
  synced=false
  echo "github: GitHub's main has commits that main lacks; nothing is published or merged until main has them"
fi
below=
while read -r head name; do
  if ! git merge-base --is-ancestor "$head" main 2>/dev/null; then
    synced=false
    echo "github: GitHub's $name has commits that main lacks; nothing is published or merged until the owner resets it"
  elif [[ -n $below ]] && ! git merge-base --is-ancestor "$below" "$head"; then
    synced=false
    echo "github: GitHub's $name lacks the batch below it; nothing is published or merged until the owner resets it"
  fi
  below=$head
done < <(jq -r '.[] | "\(.headRefOid) \(.headRefName)"' <<<"$stack")

# The agent's replies, to comments it was offered. A fix's reply waits until
# GitHub has the kept commit; a dropped fix has none, so its comment comes back.
if [[ -f $state/replies.json ]]; then
  if ! replies=$(jq -c --slurpfile offered "$state/offered.json" \
    --arg decision "$decision" --arg sha "$candidate" --arg note "$note" '
    if type == "array" then . else [] end
    | map(select(type == "object" and (.comment | type) == "number"
        and (.reply | type) == "string" and (.fixed | type) == "boolean"))
    | unique_by(.comment)
    | map(select((.fixed | not) or $decision == "keep")
        | .comment as $id
        | ($offered[0][] | select(.comment == $id)) as $offer
        | {pr: $offer.pr, thread: $offer.thread, comment: $id,
           after: (if .fixed then $sha else null end),
           body: ($note + "\n\n" + (if .fixed then "Fixed in \($sha[0:7]). " else "" end)
             # A mention could reach other people or command CodeRabbit.
             + (.reply | gsub("@(?=[A-Za-z0-9])"; "@\u200b")))})' "$state/replies.json"); then
    echo "github: the loop agent's REPLIES.json was not valid JSON; it was dropped"
    replies='[]'
  fi
  outbox --argjson new "$replies" '. + $new'
  rm "$state/replies.json"
fi

# Posts each reply whose commit, if any, GitHub has, and takes it out of the
# outbox right after, so that a stopped run repeats at most the reply it was
# posting. A fix lands in a later batch than its comment, where CodeRabbit
# reviews it, so the step resolves the comment's thread itself.
posted=0
flush() {
  local entry after
  while IFS= read -r entry; do
    after=$(jq -r '.after // empty' <<<"$entry")
    if [[ -n $after && -z $(git for-each-ref --contains "$after" \
      refs/remotes/origin/main "refs/remotes/origin/${prefix%/}" 2>/dev/null) ]]; then
      continue
    fi
    jq -r .body <<<"$entry" >"$body"
    if ! gh api "repos/$slug/pulls/$(jq .pr <<<"$entry")/comments/$(jq .comment <<<"$entry")/replies" \
      -F body=@"$body" </dev/null >/dev/null; then
      echo "github: a reply could not be posted; it is tried again next round"
      continue
    fi
    outbox --argjson entry "$entry" 'map(select(. != $entry))'
    posted=$((posted + 1))
    if [[ -n $after ]] && ! gh api graphql -f thread="$(jq -r .thread <<<"$entry")" -f query='
      mutation($thread: ID!) { resolveReviewThread(input: {threadId: $thread}) { thread { isResolved } } }' \
      </dev/null >/dev/null; then
      echo "github: a fixed comment's thread could not be resolved"
    fi
  done < <(jq -c '.[]' "$state/outbox.json")
}
flush

# Merge the stack from the bottom, as far as CodeRabbit has reviewed every
# pull request with all threads resolved, up to the highest head whose checks
# pass: a later batch may hold the fix for a failed check below it. Merge
# before publishing, so that a new batch goes onto what remains.
if $synced && [[ $stack != "[]" ]]; then
  plan=$(jq -c '
    def checks: .commits.nodes[0].commit.statusCheckRollup.contexts // {};
    def green: checks as $contexts | ($contexts.nodes // []) as $all
      | ($all | map(select(.name != "CodeRabbit"))) as $ci
      | ($ci | length) > 0 and $contexts.totalCount == ($all | length) and ($ci | all(
          if .__typename == "CheckRun"
          # A run in progress has no conclusion yet.
          then .conclusion | IN("SUCCESS", "NEUTRAL", "SKIPPED")
          else .state == "SUCCESS" end));
    def reviewed: ([checks.nodes // [] | .[] | select(.name == "CodeRabbit")] | last | .conclusion) == "SUCCESS";
    def resolved: .reviewThreads.totalCount == (.reviewThreads.nodes | length)
      and (.reviewThreads.nodes | all(.isResolved));
    . as $stack
    | [range(length) | select(. as $i | $stack[:$i + 1] | all(reviewed and resolved))] as $settled
    | ([$settled[] | select($stack[.] | green)] | last) as $top
    | if $top != null then {merge: $top}
      else (first($stack[] | select((reviewed and resolved) | not)) // ($stack | last)) as $pr
      | {number: $pr.number, waits: (if ($pr | reviewed) | not then "CodeRabbit"
          elif ($pr | resolved) | not then "review threads" else "checks" end)}
      end' <<<"$stack")
  top=$(jq -r '.merge // empty' <<<"$plan")
  if [[ -z $top ]]; then
    jq -r '"github: #\(.number) waits for \(.waits)"' <<<"$plan"
  elif head=$(jq -r --argjson top "$top" '.[$top].headRefOid' <<<"$stack") &&
    ! git merge-base --is-ancestor origin/main "$head"; then
    # GitHub's main moved and main took it in after these batches went up.
    echo "github: #$(jq -r '.[0].number' <<<"$stack") is behind GitHub's main; the owner decides"
  else
    # Each merged pull request and the one above them must target main first:
    # GitHub then counts them merged, and the one above keeps its base when the
    # merged branches go.
    while read -r number; do
      gh api -X PATCH "repos/$slug/pulls/$number" -f base=main </dev/null >/dev/null
    done < <(jq -r --argjson top "$top" '.[1:$top + 2][] | .number' <<<"$stack")
    git push -q origin "$head:refs/heads/main"
    # A branch that moved since the listing keeps the new commits.
    mapfile -t merged < <(jq -r --argjson top "$top" '.[:$top + 1][] | .headRefName' <<<"$stack")
    mapfile -t leases < <(jq -r --argjson top "$top" \
      '.[:$top + 1][] | "--force-with-lease=refs/heads/\(.headRefName):\(.headRefOid)"' <<<"$stack")
    if ! git push -q origin "${leases[@]}" --delete "${merged[@]}"; then
      echo "github: a merged branch moved on GitHub; it stays for the owner"
    fi
    echo "github: merged $(jq -r --argjson top "$top" '[.[:$top + 1][] | "#\(.number)"] | join(", ")' <<<"$stack") into GitHub's main"
    stack=$(jq -c --argjson top "$top" '.[$top + 1:]' <<<"$stack")
  fi
fi

# CodeRabbit reviews this repository only on request.
ask() {
  gh api "repos/$slug/issues/$1/comments" -f body="@$bot review" </dev/null >/dev/null
  date +%s >"$state/requested.$1"
  echo "github: asked CodeRabbit to review #$1"
}

# Publish what main has beyond the stack as a new batch on top of it: at once
# when no pull request is open, and otherwise at most every interval, so that
# reviews see batches of commits.
published=
if $synced; then
  top=$(jq -r 'last | .headRefOid // empty' <<<"$stack")
  top=${top:-$(git rev-parse origin/main)}
  last=$(cat "$state/published" 2>/dev/null || echo 0)
  if [[ -n $(git rev-list "$top..main") ]] &&
    { [[ $stack == "[]" ]] || (($(date +%s) - last >= interval)); }; then
    name=$prefix$(date -u +%Y%m%dT%H%M%S.%3NZ)
    base=$(jq -r 'last | .headRefName // "main"' <<<"$stack")
    below=$(jq -r 'last | .number // empty' <<<"$stack")
    sha=$(git rev-parse main)
    git push -q origin "$sha:refs/heads/$name"
    models=$(git rev-list "$top..main" |
      awk 'NR == FNR { commits[$1]; next } $1 in commits { sub(/^[^ ]+ /, ""); print }' - "$state/models" |
      sort -u | paste -sd, - | sed 's/,/, /g')
    {
      echo "Commits that the research loop's gate kept on main. The round script publishes each batch as a pull request on the one before it, and merges the stack from the bottom by fast-forward once CodeRabbit has reviewed it with every thread resolved and the checks pass."
      if [[ -n $below ]]; then
        echo
        echo "Stacked on #$below."
      fi
      echo
      echo "## Change"
      echo
      git log --reverse --format='- %h %s' "$top..main"
      echo
      echo "## Verification"
      echo
      echo "The gate kept each commit: its development score rose, or for a \`fix(transpiler)\` commit did not drop, and its validation score did not drop."
      echo
      echo "> [!NOTE]"
      echo "> 🤖 **Agent assistance: ${models:-Claude} via Claude Code** — implementation; replies to review comments."
    } >"$body"
    if ! published=$(gh api "repos/$slug/pulls" -f head="$name" -f base="$base" \
      -f title="feat(transpiler): research loop rules until $(date -u '+%Y-%m-%d %H:%M') UTC" \
      -F body=@"$body" --jq .number); then
      # Unless someone pushed to it since, the branch goes, so that the next
      # round publishes these commits again.
      git push -q origin --force-with-lease="refs/heads/$name:$sha" --delete "$name" ||
        echo "github: $name moved on GitHub; it stays for the owner"
      exit 1
    fi
    date +%s >"$state/published"
    echo "github: published $(git rev-list --count "$top..main") commits as #$published"
    ask "$published"
  fi
fi
flush
if ((posted)); then
  echo "github: posted $posted replies"
fi

# Ask again for the lowest pull request that CodeRabbit has not reviewed, as
# when it was rate limited, at most every interval: it holds up the merge.
lowest=$(jq -r '[.[] | select(([.commits.nodes[0].commit.statusCheckRollup.contexts.nodes // [] | .[]
    | select(.name == "CodeRabbit")] | last) as $rabbit
    | $rabbit == null or ($rabbit.status == "COMPLETED" and $rabbit.conclusion != "SUCCESS"))]
  | first | .number // empty' <<<"$stack")
if [[ -n $lowest ]] &&
  (($(date +%s) - $(cat "$state/requested.$lowest" 2>/dev/null || echo 0) >= interval)); then
  ask "$lowest"
fi

# What the next session should handle: comments from CodeRabbit or the owner
# in threads that a third party did not start, on any batch, and the failed
# checks of the top batch, which holds every commit. A thread whose reply waits
# in the outbox is answered.
prs=$(pull_requests)
stack=$(stack_of "$prs")
items=$(jq -c --arg viewer "$viewer" --arg bot "$bot" --argjson disputes "$disputes" \
  --slurpfile outbox "$state/outbox.json" '
  def reply: .author.login == $viewer and (.body | startswith("> [!NOTE]\n> 🤖 **"));
  [.[] | .number as $pr | .reviewThreads.nodes[]
    | select((.isResolved | not) and (.comments.nodes[0].author.login | IN($viewer, $bot)))
    | [.comments.nodes[] | select(.author.login | IN($viewer, $bot))] as $comments
    | $comments[0].databaseId as $id
    | select([$outbox[0][].comment] | index($id) | not)
    | (.comments.totalCount > (.comments.nodes | length)) as $long
    | [range($comments | length) | select($comments[.] | reply)] as $replies
    | ($replies | last) as $replied
    | {pr: $pr, thread: .id, comment: $id, url: $comments[0].url, path: $comments[0].path,
       line: $comments[0].line, comments: $comments,
       state: (if $long then "owner"
         elif $replied == null then "open"
         elif any($comments[$replied + 1:][]; .author.login == $viewer) then "open"
         elif ($comments | length) == $replied + 1 then "waiting"
         # CodeRabbit answered the reply without resolving the thread.
         elif ($replies | length) < $disputes then "open"
         else "owner" end),
       why: (if $long then "the thread has more comments than the step reads"
         else "CodeRabbit still disagrees after \($disputes) replies" end)}]' <<<"$stack")
jq -c '[.[] | select(.state == "open") | {comment, pr, thread}]' <<<"$items" >"$state/offered.json"
top=$(jq -c 'last // {}' <<<"$stack")
{
  jq -r --arg viewer "$viewer" --arg bot "$bot" '
    def reply: .author.login == $viewer and (.body | startswith("> [!NOTE]\n> 🤖 **"));
    .[] | select(.state == "open")
    | "## Comment \(.comment) on `\(.path)`\(if .line then " line \(.line)" else "" end)\n",
      (.comments[]
        | "**\(if .author.login == $bot then "CodeRabbit"
            elif reply then "Your earlier reply"
            else "The owner" end):**\n",
          (.body | gsub("<!--[\\s\\S]*?-->"; "") | gsub("\\A\\s+|\\s+\\z"; "")) + "\n")' <<<"$items"
  # Checks that failed on the agent's code. Other ends that block the merge,
  # such as a cancelled run, go to the owner below.
  jq -r '.commits.nodes[0].commit.statusCheckRollup.contexts.nodes // [] | .[]
    | select((.__typename == "CheckRun" and .name != "CodeRabbit"
          and (.conclusion | IN("FAILURE", "TIMED_OUT")))
        or (.__typename == "StatusContext" and (.state | IN("FAILURE", "ERROR"))))
    | [.name // .context, ((.detailsUrl // "" | capture("/job/(?<job>[0-9]+)").job) // "")] | @tsv' <<<"$top" |
    while IFS=$'\t' read -r name job; do
      echo "## Failed check: $name"
      echo
      echo '```text'
      if [[ -n $job ]]; then
        gh run view --repo "$slug" --job "$job" --log-failed </dev/null 2>/dev/null |
          sed 's/\x1b\[[0-9;]*m//g' | tail -n 150 || true
      fi
      echo '```'
      echo
    done
} >"$body"
if [[ -s $body ]]; then
  {
    echo "# Reviews"
    echo
    echo "Open review comments and failed checks on the loop's pull requests, for commits that the gate kept. loop/program.md says how to handle them."
    echo
    cat "$body"
  } >"$loop/REVIEWS.md"
fi
jq -r '"github: \([.[] | select(.state == "open")] | length) comments for the loop agent, \([.[] | select(.state == "waiting")] | length) waiting for CodeRabbit",
  (.[] | select(.state == "owner") | "github: \(.why); the owner decides: \(.url)")' <<<"$items"
jq -r '.number as $number | .commits.nodes[0].commit.statusCheckRollup.contexts.nodes // [] | .[]
  | select(.__typename == "CheckRun" and .name != "CodeRabbit" and .conclusion != null
      and (.conclusion | IN("SUCCESS", "NEUTRAL", "SKIPPED", "FAILURE", "TIMED_OUT") | not))
  | "github: the check \(.name) on #\($number) ended \(.conclusion); the owner decides"' <<<"$top"
