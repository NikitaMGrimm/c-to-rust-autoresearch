#!/usr/bin/env bash
# Ends one iteration of the research loop, after the loop agent's session:
# audits the agent's transcripts, runs the gate on its commit, keeps the
# commit on main or drops it, and makes a fresh loop checkout from main for
# the next iteration. With --github, loop/github then takes main to GitHub
# and brings the reviews back. Run it by this checkout's path, never the loop
# checkout's copy, which the agent can change. See docs/architecture.md.
set -euo pipefail
trap 'exit 2' ERR

github=false
if [[ ${1-} == --github ]]; then
  github=true
  shift
fi
if (($# < 2)); then
  cat >&2 <<'EOF'
usage: loop/round [--github] PRIVATE_DIR LOOP_DIR [DENIED_DIR...]
Takes the arguments of loop/setup, which it runs again for the next iteration.
Exits 0 when the gate decided, 1 when there was nothing to judge or the audit
found contact with the private sets, and 2 on errors. A failed GitHub step
only prints a warning.
EOF
  exit 2
fi
repo=$(cd "$(dirname "$0")/.." && pwd -P)
private=$(cd "$1" && pwd -P)
loop=$(cd "$2" && pwd -P)
shift 2
denied=()
for dir in "$@"; do
  denied+=("$(cd "$dir" && pwd -P)")
done
# The checkout is deleted below, so it must be one that loop/setup made.
settings=$loop/.claude/settings.local.json
if [[ $loop == "$repo" || ! -f $settings ]] ||
  ! jq -e --arg guard "$repo/loop/guard" \
    '.hooks.PreToolUse[0].hooks[0].command | startswith($guard | @sh)' "$settings" >/dev/null ||
  [[ $(git config -f "$loop/.git/config" --get c2r.loop) != true ]]; then
  echo "$loop is not a loop checkout made by loop/setup" >&2
  exit 2
fi
name=$(printf %s "$loop" | tr -c 'a-zA-Z0-9' '-')
transcripts=$HOME/.claude/projects/$name
state=$repo/local/loop/$name
mkdir -p "$state"
# Two rounds at once would judge the same commit and delete each other's clone.
exec 9>"$repo/local/loop/lock"
if ! flock -n 9; then
  echo "round stopped: another round is running" >&2
  exit 2
fi
cd "$repo"

# After a look at a private program, the gate's results would mean nothing.
status=0
cargo run -q -p transcripts --bin audit -- "$private" "$transcripts" || status=$?
if ((status == 1)); then
  echo "round stopped: the audit found contact with the private sets; the gate did not run" >&2
  exit 1
elif ((status)); then
  exit 2
fi

# Fetching only reads the loop checkout's objects. Git run inside it would
# apply settings and hooks that the agent could have changed.
stamp=$(date -u +%Y%m%dT%H%M%S%NZ)
git fetch -q --no-tags --no-recurse-submodules "$loop" "HEAD:refs/loop/$stamp"
base=$(git rev-parse main)
candidate=$(git rev-parse "refs/loop/$stamp")
if [[ $candidate == "$base" ]]; then
  git update-ref -d "refs/loop/$stamp"
  echo "round stopped: the loop checkout has no new commit" >&2
  exit 1
fi

report=$(mktemp)
printed=$(mktemp)
trap 'rm -f "$report" "$printed"' EXIT
since=()
if [[ -f $state/since ]]; then
  since=(--since "$(cat "$state/since")")
fi
cargo run -q -p transcripts --bin usage -- "${since[@]}" "$transcripts" >"$report"
status=0
cargo run -q -p eval --bin gate -- "$private" "$base" "$candidate" --usage "$report" \
  >"$printed" || status=$?
cat "$printed"
if ((status > 1)); then
  echo "round stopped: the gate failed; nothing was changed" >&2
  exit 2
fi
decision=reject
if ((status == 0)); then
  git merge -q --ff-only "$candidate"
  decision=keep
fi
# What the next session may see: each commit and the gate's printed results.
{
  echo "## $(git log -1 --format='%h %s' "$candidate")"
  echo
  cat "$printed"
  echo
} >>"$state/rounds.md"

# The agent's answers to review comments, for loop/github. A link could point
# anywhere.
if $github && [[ -f $loop/REPLIES.json && ! -L $loop/REPLIES.json ]]; then
  cp "$loop/REPLIES.json" "$state/replies.json"
fi
rm -rf "$loop"
"$repo/loop/setup" "$private" "$loop" "${denied[@]}" >/dev/null
cp "$state/rounds.md" "$loop/ROUNDS.md"
date -u +%Y-%m-%dT%H:%M:%SZ >"$state/since"
if $github; then
  # The model that wrote most of the session, by its display name, such as
  # Opus 5.5 for claude-opus-5-5.
  model=$(jq -r '.models // {} | to_entries | max_by(.value.output_tokens) | .key // empty' "$report" |
    sed -E 's/^claude-([a-z])([a-z]*)-([0-9]+)-([0-9]+)\b.*$/\u\1\2 \3.\4/')
  "$repo/loop/github" "$state" "$loop" "$candidate" "$decision" "${model:-Claude}" ||
    echo "round: the GitHub step failed; it runs again after the next round" >&2
fi
echo "next iteration: a fresh $loop at $(git log -1 --format='%h %s' main)"
