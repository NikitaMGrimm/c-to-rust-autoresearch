#!/usr/bin/env bash
# Ends one iteration of the research loop, after the loop agent's session:
# audits the agent's transcripts, runs the gate on its commit, keeps the
# commit on main or drops it, and makes a fresh loop checkout from main for
# the next iteration. Run it by this checkout's path, never the loop
# checkout's copy, which the agent can change. See docs/architecture.md.
set -euo pipefail

if (($# < 2)); then
  cat >&2 <<'EOF'
usage: loop/round PRIVATE_DIR LOOP_DIR [DENIED_DIR...]
Takes the arguments of loop/setup, which it runs again for the next iteration.
Exits 0 when the gate decided, 1 when there was nothing to judge or the audit
found contact with the private sets, and 2 on errors.
EOF
  exit 2
fi
repo=$(cd "$(dirname "$0")/.." && pwd -P)
private=$(cd "$1" && pwd -P)
loop=$(cd "$2" && pwd -P)
shift 2
# The checkout is deleted below, so it must be one that loop/setup made.
if [[ $loop == "$repo" || ! -f $loop/.claude/settings.local.json ]] ||
  ! grep -qF -- "'$repo/loop/guard'" "$loop/.claude/settings.local.json" ||
  [[ $(git config -f "$loop/.git/config" --get c2r.loop) != true ]]; then
  echo "$loop is not a loop checkout made by loop/setup" >&2
  exit 2
fi
state=$repo/local/loop
mkdir -p "$state"
transcripts="$HOME/.claude/projects/$(printf %s "$loop" | tr -c 'a-zA-Z0-9' '-')"
cd "$repo"

# After a look at a private program, the gate's results would mean nothing.
status=0
cargo run -q -p transcripts --bin audit -- "$private" "$transcripts" || status=$?
if ((status == 1)); then
  echo "round stopped: the audit found contact with the private sets; the gate did not run" >&2
  exit 1
elif ((status)); then
  exit 2
fi

# Fetching only reads the loop checkout's objects. Git run inside it would
# apply settings and hooks that the agent could have changed.
stamp=$(date -u +%Y%m%dT%H%M%S%NZ)
git fetch -q --no-tags --no-recurse-submodules "$loop" "HEAD:refs/loop/$stamp"
base=$(git rev-parse main)
candidate=$(git rev-parse "refs/loop/$stamp")
if [[ $candidate == "$base" ]]; then
  git update-ref -d "refs/loop/$stamp"
  echo "round stopped: the loop checkout has no new commit" >&2
  exit 1
fi

report=$(mktemp)
trap 'rm -f "$report"' EXIT
since=()
if [[ -f $state/since ]]; then
  since=(--since "$(cat "$state/since")")
fi
cargo run -q -p transcripts --bin usage -- "${since[@]}" "$transcripts" >"$report"
status=0
cargo run -q -p eval --bin gate -- "$private" "$base" "$candidate" --usage "$report" |
  tee "$state/gate.txt" || status=$?
if ((status > 1)); then
  echo "round stopped: the gate failed; nothing was changed" >&2
  exit 2
fi
if ((status == 0)); then
  git merge -q --ff-only "$candidate"
fi
# What the next session may see: each commit and the gate's printed results.
{
  echo "## $(git log -1 --format='%h %s' "$candidate")"
  echo
  cat "$state/gate.txt"
  echo
} >>"$state/rounds.md"

rm -rf "$loop"
"$repo/loop/setup" "$private" "$loop" "$@" >/dev/null
cp "$state/rounds.md" "$loop/ROUNDS.md"
date -u +%Y-%m-%dT%H:%M:%SZ >"$state/since"
echo "next iteration: a fresh $loop at $(git log -1 --format='%h %s' main)"
