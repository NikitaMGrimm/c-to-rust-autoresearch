#!/usr/bin/env bash
# Ends one iteration of the research loop, after the loop agent's session:
# audits the agent's transcripts, runs the gate on its commit, keeps the
# commit on main or drops it, and makes a fresh loop checkout from main for
# the next iteration. With --run, a run's branch takes main's place. With
# --github, loop/github then takes main to GitHub and brings the reviews back.
# Run it by this checkout's path, never the loop checkout's copy, which the
# agent can change. See docs/architecture.md.
set -euo pipefail
trap 'exit 2' ERR

usage() {
  cat >&2 <<'EOF'
usage: loop/round [--github | --run RUN] [--dev-only] PRIVATE_DIR LOOP_DIR [DENIED_DIR...]
Takes the arguments of loop/setup, which it runs again for the next iteration.
With --run, the commit is judged against and kept on the branch run/RUN, which
loop/run made, and the gate logs to PRIVATE_DIR/runs/RUN; --dev-only goes to
the gate. Exits 0 when the gate decided, 1 when the audit found contact with
the private sets, 3 when the loop checkout has no new commit, 4 when a run's
session is set aside because its calls named private places, which its
sandbox hid, and 2 on errors. A failed GitHub step only prints a warning.
EOF
  exit 2
}
github=false
run=
gate=()
while [[ ${1-} == --* ]]; do
  case $1 in
    --github) github=true ;;
    --dev-only) gate+=(--dev-only) ;;
    --run)
      run=${2-}
      [[ -n $run ]] || usage
      shift
      ;;
    *) usage ;;
  esac
  shift
done
branch=main
if [[ -n $run ]]; then
  # The names the gate allows for its log directory, and git for a branch.
  if $github || [[ ! $run =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] ||
    ! git check-ref-format "refs/heads/run/$run"; then
    usage
  fi
  branch=run/$run
  gate+=(--run "$run")
fi
if (($# < 2)); then
  usage
fi
repo=$(cd "$(dirname "$0")/.." && pwd -P)
private=$(cd "$1" && pwd -P)
loop=$(cd "$2" && pwd -P)
shift 2
denied=()
for dir in "$@"; do
  denied+=("$(cd "$dir" && pwd -P)")
done
# The checkout is deleted below, so it must be one that loop/setup made.
settings=$loop/.claude/settings.local.json
if [[ $loop == "$repo" || ! -f $settings ]] ||
  ! jq -e --arg guard "$repo/loop/guard" \
    '.hooks.PreToolUse[0].hooks[0].command | startswith($guard | @sh)' "$settings" >/dev/null ||
  [[ $(git config -f "$loop/.git/config" --get c2r.loop) != true ]]; then
  echo "$loop is not a loop checkout made by loop/setup" >&2
  exit 2
fi
name=$(printf %s "$loop" | tr -c 'a-zA-Z0-9' '-')
transcripts=$HOME/.claude/projects/$name
state=$repo/local/loop/$name
if [[ -n $run ]]; then
  state=$repo/local/runs/$run
fi
mkdir -p "$state" "$repo/local/loop"
# Two rounds at once would judge the same commit and delete each other's clone.
exec 9>"$repo/local/loop/lock"
if ! flock -n 9; then
  echo "round stopped: another round is running" >&2
  exit 2
fi
cd "$repo"
if ! base=$(git rev-parse -q --verify "refs/heads/$branch"); then
  echo "round stopped: there is no branch $branch; loop/run makes it" >&2
  exit 2
fi

# After a look at a private program, the gate's results would mean nothing.
status=0
found=$(cargo run -q -p transcripts --bin audit -- "$private" "$transcripts") || status=$?
printf '%s\n' "$found"
if ((status == 1)); then
  # A run's sessions run in a sandbox that hides the private places, so a call
  # that names one reached nothing. Such a session is set aside unjudged, with
  # its transcripts, which later audits would report again. A private
  # program's name, or a record the audit cannot read, is contact.
  if [[ -n $run ]] && ! grep -q -E ': (private program |unreadable record$)' <<<"$found"; then
    aside=$state/flagged/$(date -u +%Y%m%dT%H%M%S%NZ)
    mkdir -p "$aside"
    while IFS= read -r line; do
      if [[ $line == "$transcripts/"* ]]; then
        session=${line#"$transcripts/"}
        session=${session%%[/:]*}
        session=${session%.jsonl}
        for path in "$transcripts/$session.jsonl" "$transcripts/$session"; do
          if [[ -e $path ]]; then
            mv -- "$path" "$aside/"
          fi
        done
      fi
    done <<<"$found"
    echo "round stopped: the audit found calls that name private places but no contact; the session is set aside in $aside and the gate did not run" >&2
    exit 4
  fi
  echo "round stopped: the audit found contact with the private sets; the gate did not run" >&2
  exit 1
elif ((status)); then
  exit 2
fi

# Fetching only reads the loop checkout's objects. Git run inside it would
# apply settings and hooks that the agent could have changed.
stamp=$(date -u +%Y%m%dT%H%M%S%NZ)
git fetch -q --no-tags --no-recurse-submodules "$loop" "HEAD:refs/loop/$stamp"
candidate=$(git rev-parse "refs/loop/$stamp")
if [[ $candidate == "$base" ]]; then
  git update-ref -d "refs/loop/$stamp"
  echo "round stopped: the loop checkout has no new commit" >&2
  exit 3
fi

report=$(mktemp)
printed=$(mktemp)
trap 'rm -f "$report" "$printed"' EXIT
since=()
if [[ -f $state/since ]]; then
  since=(--since "$(cat "$state/since")")
fi
cargo run -q -p transcripts --bin usage -- "${since[@]}" "$transcripts" >"$report"
status=0
cargo run -q -p eval --bin gate -- "$private" "$base" "$candidate" --usage "$report" \
  "${gate[@]}" >"$printed" || status=$?
cat "$printed"
if ((status > 1)); then
  echo "round stopped: the gate failed; nothing was changed" >&2
  exit 2
fi
decision=reject
if ((status == 0)); then
  # Main is checked out here; a run's branch is not.
  if [[ $branch == main ]]; then
    git merge -q --ff-only "$candidate"
  else
    git update-ref "refs/heads/$branch" "$candidate" "$base"
  fi
  decision=keep
fi
# The model that wrote most of the session, by its display name, such as
# Opus 5.5 for claude-opus-5-5. loop/github names it on the pull request.
model=$(jq -r '.models // {} | to_entries | max_by(.value.output_tokens) | .key // empty' "$report" |
  sed -E 's/^claude-([a-z])([a-z]*)-([0-9]+)-([0-9]+)\b.*$/\u\1\2 \3.\4/')
model=${model:-Claude}
if [[ $decision == keep ]]; then
  echo "$candidate $model" >>"$state/models"
fi
# What the next session may see: each commit and the gate's printed results.
{
  echo "## $(git log -1 --format='%h %s' "$candidate")"
  echo
  cat "$printed"
  echo
} >>"$state/rounds.md"

# The agent's answers to review comments, for loop/github. A link could point
# anywhere.
if $github && [[ -f $loop/REPLIES.json && ! -L $loop/REPLIES.json ]]; then
  cp "$loop/REPLIES.json" "$state/replies.json"
fi
rm -rf "$loop"
"$repo/loop/setup" --branch "$branch" "$private" "$loop" "${denied[@]}" >/dev/null
cp "$state/rounds.md" "$loop/ROUNDS.md"
date -u +%Y-%m-%dT%H:%M:%SZ >"$state/since"
if $github; then
  "$repo/loop/github" "$state" "$loop" "$candidate" "$decision" "$model" ||
    echo "round: the GitHub step failed; it runs again after the next round" >&2
fi
echo "next iteration: a fresh $loop at $(git log -1 --format='%h %s' "$branch")"
